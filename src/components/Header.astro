---
import { site } from '../data/site';

interface Props {
  current: string;
}

const { current } = Astro.props;

const links = [
  { href: '/', label: '首页' },
  { href: '/xuexiu/', label: '学修' },
  { href: '/reference/', label: '参考资料' },
  { href: '/download/', label: '下载' },
  { href: '/feedback/', label: '问题反馈' },
];

function isActive(href: string) {
  if (href === '/') return current === '/';
  if (href === '/xuexiu/') {
    return (
      current.startsWith('/xuexiu/') ||
      current.startsWith('/mod/') ||
      current.startsWith('/lunhui/') ||
      current.startsWith('/qianxing/') ||
      current.startsWith('/foguang/') ||
      current.startsWith('/buli/')
    );
  }
  return current.startsWith(href);
}
---

<header class="site-header" id="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">{site.name}</a>
    <button
      type="button"
      class="nav-toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="打开菜单"
    >
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
      <span class="nav-toggle__bar" aria-hidden="true"></span>
    </button>
    <nav class="nav" id="site-nav" aria-label="主导航">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById('site-header');
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('site-nav');
    if (!header || !toggle || !nav) return;

    const setOpen = (open) => {
      header.classList.toggle('is-nav-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
    };

    toggle.addEventListener('click', () => {
      setOpen(!header.classList.contains('is-nav-open'));
    });

    nav.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    const isMobileLayout = () =>
      window.matchMedia('(max-width: 900px), (hover: none) and (pointer: coarse)').matches;

    window.addEventListener('resize', () => {
      if (!isMobileLayout()) setOpen(false);
    });
  })();
</script>
