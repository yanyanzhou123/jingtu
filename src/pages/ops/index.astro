---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="运营后台" description="慧灯净土内容架构与上传">
  <div class="page-hero">
    <div class="wrap">
      <p class="group-label" style="margin-top: 0;">内部工具</p>
      <h1>运营后台</h1>
      <p>
        学修为主要内容：左侧选模块，模块内为章节 → 课；进入课后再编辑文字、上传音视频。
        参考书籍与公众号好文在上方分区进入，属于材料区，不计入学修课表。
      </p>
    </div>
  </div>

  <section class="section" style="padding-top: 0;">
    <div class="wrap">
      <div id="ops-login" class="ops-panel">
        <p class="ops-label">登录</p>
        <form id="login-form" class="ops-form-simple">
          <input type="password" name="password" placeholder="运营密码" autocomplete="current-password" required />
          <button type="submit" class="btn btn--solid" style="color:#fbf6e6;">登录</button>
        </form>
        <p id="login-msg" class="ops-msg" hidden></p>
      </div>

      <div id="ops-app" hidden>
        <div class="ops-workspace-tabs" role="tablist" aria-label="运营分区">
          <button type="button" class="ops-ws-tab is-active" data-ws="module">学修</button>
          <button type="button" class="ops-ws-tab" data-ws="refs">参考书籍</button>
          <button type="button" class="ops-ws-tab" data-ws="articles">公众号好文</button>
        </div>

        <div class="ops-sticky-bar">
          <div id="dirty-banner" class="ops-dirty" hidden>
            有未保存的修改，请点「保存到服务器」。上传成功会自动保存。多人同时编辑时若冲突会提示重新加载；保存前自动备份上一版。
          </div>
          <div class="ops-toolbar">
            <div class="ops-toolbar__ctx">
              <span class="ops-toolbar__label" id="ops-ctx-label">学修</span>
              <strong id="ops-ctx-title">请选择模块</strong>
            </div>
            <div class="ops-toolbar__actions">
              <button type="button" id="btn-save" class="btn btn--solid" style="color:#fbf6e6;">保存到服务器</button>
              <button type="button" id="btn-reload" class="btn" style="color:inherit;border-color:var(--line);">重新加载</button>
              <button type="button" id="logout-btn" class="btn" style="color:inherit;border-color:var(--line);">退出</button>
            </div>
            <span id="save-msg" class="ops-msg" style="margin:0;"></span>
          </div>
        </div>

        <div id="passages-panel" class="ops-cards-panel ops-cards-panel--collapsible">
          <button type="button" class="ops-cards-toggle" id="btn-passages-toggle" aria-expanded="false">
            <strong>问答索引（向量）</strong>
            <span id="passages-summary" class="ops-cards-summary">加载中…</span>
            <span class="ops-cards-toggle__hint">展开</span>
          </button>
          <div class="ops-cards-body" id="passages-body" hidden>
            <p class="ops-cards-hint">
              解惑已改用段落向量混合检索。保存课文后会自动增量重建；也可点下方按钮手动预热。
            </p>
            <div class="ops-cards-actions">
              <button type="button" id="btn-passages-warm" class="btn ops-mini" style="color:inherit;border-color:var(--line);">重建/预热一批</button>
              <button type="button" id="btn-passages-refresh" class="btn ops-mini" style="color:inherit;border-color:var(--line);">刷新状态</button>
            </div>
            <p id="passages-msg" class="ops-msg" hidden style="margin:0.5rem 0 0;"></p>
          </div>
        </div>

        <div id="feedback-panel" class="ops-cards-panel ops-cards-panel--collapsible">
          <button type="button" class="ops-cards-toggle" id="btn-feedback-toggle" aria-expanded="false">
            <strong>问题反馈</strong>
            <span id="feedback-summary" class="ops-cards-summary">未加载</span>
            <span class="ops-cards-toggle__hint">展开</span>
          </button>
          <div class="ops-cards-body" id="feedback-body" hidden>
            <div class="fb-ops-filters">
              <select id="fb-filter-status" aria-label="按状态筛选">
                <option value="">全部状态</option>
                <option value="new">待处理</option>
                <option value="read">已读</option>
                <option value="archived">已归档</option>
              </select>
              <select id="fb-filter-type" aria-label="按类型筛选">
                <option value="">全部类型</option>
                <option value="practice">修行问题</option>
                <option value="system">系统问题</option>
              </select>
              <button type="button" id="btn-fb-refresh" class="btn ops-mini" style="color:inherit;border-color:var(--line);">刷新</button>
              <span id="fb-ops-count" class="fb-ops-count"></span>
            </div>
            <div id="feedback-list" class="fb-ops-list">
              <p class="fb-ops-empty">点「刷新」加载反馈列表。</p>
            </div>
          </div>
        </div>

        <div class="ops-grid" id="ops-grid">
          <aside class="ops-side" id="ops-side">
            <div class="ops-side-head">
              <p class="ops-label" style="margin:0;">学修模块</p>
              <button type="button" id="btn-add-module" class="btn ops-mini" style="color:inherit;border-color:var(--line);">+ 添加</button>
            </div>
            <div class="ops-side-filters">
              <input type="search" id="mod-search" class="ops-side-search" placeholder="搜索模块…" autocomplete="off" />
              <select id="mod-status-filter" class="ops-side-select" aria-label="按状态筛选">
                <option value="all">全部状态</option>
                <option value="open">仅开放中</option>
                <option value="coming">仅即将开放</option>
              </select>
            </div>
            <div id="module-list" class="ops-nav"></div>
          </aside>

          <div class="ops-main" id="module-editor">
            <p class="ops-empty">请选择左侧模块</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<link rel="stylesheet" href="/ops-app.css?v=20260805y" />
<script type="module" src="/ops-video-compress.js?v=20260725i"></script>
<script src="/ops-app.js?v=20260731g" defer></script>

<style>
  .fb-ops-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 0 0.75rem;
  }
  .fb-ops-filters select {
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.7);
    font: inherit;
    font-size: 0.88rem;
  }
  .fb-ops-count {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .fb-ops-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fb-ops-item {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
    padding: 0.65rem 0.8rem;
  }
  .fb-ops-item.is-new {
    border-left: 3px solid var(--jade);
  }
  .fb-ops-item__head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.8rem;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-bottom: 0.35rem;
  }
  .fb-ops-item__type {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--jade);
    color: var(--jade-deep);
    font-size: 0.78rem;
  }
  .fb-ops-item__type.is-system {
    border-color: #6b7280;
    color: #4b5563;
  }
  .fb-ops-item__email {
    color: var(--ink-soft);
  }
  .fb-ops-item__content {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.7;
    margin: 0.25rem 0 0.5rem;
  }
  .fb-ops-item__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
  .fb-ops-status-btn {
    appearance: none;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.6);
    color: var(--ink-soft);
    padding: 0.3rem 0.6rem;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .fb-ops-status-btn:hover {
    border-color: var(--jade);
    color: var(--jade-deep);
  }
  .fb-ops-status-btn.is-current {
    border-color: var(--jade);
    background: rgba(201, 162, 39, 0.15);
    color: var(--jade-deep);
    cursor: default;
  }
  .fb-ops-empty {
    font-family: var(--font-sans);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>

<script is:inline>
  (() => {
    const TYPE_LABELS = { practice: '修行问题', system: '系统问题' };
    const STATUS_LABELS = { new: '待处理', read: '已读', archived: '已归档' };

    const toggleBtn = document.getElementById('btn-feedback-toggle');
    const body = document.getElementById('feedback-body');
    const hint = toggleBtn?.querySelector('.ops-cards-toggle__hint');
    const list = document.getElementById('feedback-list');
    const summary = document.getElementById('feedback-summary');
    const countEl = document.getElementById('fb-ops-count');
    const statusFilter = document.getElementById('fb-filter-status');
    const typeFilter = document.getElementById('fb-filter-type');
    const refreshBtn = document.getElementById('btn-fb-refresh');

    let loaded = false;
    let loading = false;

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]),
      );
    }

    function fmtTime(iso) {
      if (!iso) return '';
      try {
        return new Date(iso).toLocaleString('zh-CN', { hour12: false });
      } catch {
        return iso;
      }
    }

    async function loadList() {
      if (loading) return;
      loading = true;
      summary.textContent = '加载中…';
      list.innerHTML = '<p class="fb-ops-empty">加载中…</p>';
      const params = new URLSearchParams();
      if (statusFilter.value) params.set('status', statusFilter.value);
      if (typeFilter.value) params.set('type', typeFilter.value);
      try {
        const res = await fetch(`/api/feedback?${params.toString()}`, { credentials: 'same-origin' });
        if (res.status === 401) {
          list.innerHTML = '<p class="fb-ops-empty">未登录或登录已过期，请先登录。</p>';
          summary.textContent = '未登录';
          return;
        }
        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || `加载失败（${res.status}）`);
        }
        renderList(data.items || []);
        loaded = true;
      } catch (err) {
        list.innerHTML = `<p class="fb-ops-empty">加载失败：${escapeHtml(String(err.message || err))}</p>`;
        summary.textContent = '加载失败';
      } finally {
        loading = false;
      }
    }

    function renderList(items) {
      const newCount = items.filter((x) => x.status === 'new').length;
      summary.textContent = `共 ${items.length} 条${newCount ? ` · 待处理 ${newCount}` : ''}`;
      countEl.textContent = `${items.length} 条`;
      if (!items.length) {
        list.innerHTML = '<p class="fb-ops-empty">暂无反馈。</p>';
        return;
      }
      list.innerHTML = items
        .map((it) => {
          const isNew = it.status === 'new';
          const typeClass = it.type === 'system' ? 'is-system' : '';
          const buttons = ['new', 'read', 'archived']
            .map((s) => {
              const cur = s === it.status ? ' is-current' : '';
              return `<button type="button" class="fb-ops-status-btn${cur}" data-id="${escapeHtml(it.id)}" data-status="${s}">${STATUS_LABELS[s]}</button>`;
            })
            .join('');
          return `
            <div class="fb-ops-item${isNew ? ' is-new' : ''}">
              <div class="fb-ops-item__head">
                <span class="fb-ops-item__type ${typeClass}">${escapeHtml(TYPE_LABELS[it.type] || it.type)}</span>
                <span class="fb-ops-item__email">${escapeHtml(it.email || '')}</span>
                <span>${fmtTime(it.created_at)}</span>
              </div>
              <p class="fb-ops-item__content">${escapeHtml(it.content || '')}</p>
              <div class="fb-ops-item__actions">${buttons}</div>
            </div>`;
        })
        .join('');
    }

    async function setStatus(id, status) {
      try {
        const res = await fetch('/api/feedback', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ id, status }),
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || `更新失败（${res.status}）`);
        }
        await loadList();
      } catch (err) {
        alert(String(err.message || err));
      }
    }

    toggleBtn?.addEventListener('click', () => {
      const open = body.hidden;
      body.hidden = !open;
      toggleBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (hint) hint.textContent = open ? '收起' : '展开';
      if (open && !loaded) loadList();
    });

    refreshBtn?.addEventListener('click', () => loadList());
    statusFilter?.addEventListener('change', () => loadList());
    typeFilter?.addEventListener('change', () => loadList());

    list?.addEventListener('click', (e) => {
      const btn = e.target.closest('.fb-ops-status-btn:not(.is-current)');
      if (!btn) return;
      setStatus(btn.dataset.id, btn.dataset.status);
    });
  })();
</script>
