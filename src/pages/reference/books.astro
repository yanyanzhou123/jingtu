---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="参考书籍" description="学修相关 PDF 与参考书">
  <article class="page-hero yt-page">
    <div class="wrap yt-hero">
      <a class="yt-back" href="/reference/">← 返回参考资料</a>
      <p class="group-label" style="margin-top: 0;">参考资料</p>
      <h1>参考书籍</h1>
      <p>独立于学修课表的 PDF 与参考书，由运营后台「参考书籍」维护。</p>

      <div id="ref-books-body" class="yt-setup" style="border-top:none;padding-top:0.5rem;">
        <p class="yt-msg" style="margin-top:0;">加载中…</p>
      </div>
    </div>
  </article>
</BaseLayout>

<link rel="stylesheet" href="/yantao.css?v=20260805y" />
<script src="/jx-catalog.js?v=20260731e" defer></script>
<script is:inline>
document.addEventListener('DOMContentLoaded', async () => {
  const body = document.getElementById('ref-books-body');
  try {
    const catalog = await JX.fetchCatalog();
    const refs = catalog.references || [];
    if (!refs.length) {
      body.innerHTML = '<p class="note">暂无参考书籍。</p>';
      return;
    }
    body.innerHTML = `<ul class="lesson-list">${refs
      .map((ref) => {
        const url = JX.assetUrl(ref.path);
        const id = ref.id ? ` id="${JX.escape(ref.id)}"` : '';
        return `
          <li${id}>
            <a href="${url || '#'}" ${url ? 'target="_blank" rel="noopener"' : ''}>
              <span class="lesson-list__num">PDF</span>
              <div>
                <h2 class="lesson-list__title">《${JX.escape(ref.title)}》</h2>
                ${ref.meta ? `<p class="lesson-list__meta">${JX.escape(ref.meta)}</p>` : ''}
                <p class="lesson-list__summary">${
                  url ? '点击打开或下载' : '尚未上传文件，请在运营后台上传'
                }</p>
              </div>
            </a>
          </li>`;
      })
      .join('')}</ul>`;
    const hash = decodeURIComponent((location.hash || '').replace(/^#/, ''));
    if (hash) document.getElementById(hash)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch (e) {
    body.innerHTML = `<p>加载失败：${JX.escape(e.message || e)}</p>`;
  }
});
</script>
